{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "allowJs": true,
    "esModuleInterop": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@macavitymadcap/hyper-dank-components": ["libs/components/src/index.ts"],
      "@macavitymadcap/hyper-dank-database": ["libs/database/src/index.ts"],
      "@macavitymadcap/hyper-dank-database/testing": ["libs/database/src/testing.ts"],
      "@macavitymadcap/hyper-dank-http": ["libs/http/src/index.ts"]
    },
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "exclude": [".cache", "coverage", "dist", "playwright-report", "storybook-static", "test-results"]
}
