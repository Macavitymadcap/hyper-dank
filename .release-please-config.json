{
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "hyper-dank-libraries",
      "components": [
        "hyper-dank-ui",
        "hyper-dank-data",
        "hyper-dank-transport",
        "hyper-dank-automation"
      ]
    }
  ],
  "packages": {
    ".": {
      "package-name": "hyper-dank",
      "release-type": "node",
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Refactoring" },
        { "type": "docs", "section": "Documentation" },
        { "type": "test", "section": "Tests" },
        { "type": "build", "section": "Build" },
        { "type": "ci", "section": "CI" },
        { "type": "chore", "section": "Chores" }
      ]
    },
    "libs/components": {
      "component": "hyper-dank-ui",
      "package-name": "@macavitymadcap/hyper-dank-ui",
      "release-type": "node",
      "include-component-in-tag": true
    },
    "libs/database": {
      "component": "hyper-dank-data",
      "package-name": "@macavitymadcap/hyper-dank-data",
      "release-type": "node",
      "include-component-in-tag": true
    },
    "libs/http": {
      "component": "hyper-dank-transport",
      "package-name": "@macavitymadcap/hyper-dank-transport",
      "release-type": "node",
      "include-component-in-tag": true
    },
    "libs/scripts": {
      "component": "hyper-dank-automation",
      "package-name": "@macavitymadcap/hyper-dank-automation",
      "release-type": "node",
      "include-component-in-tag": true
    }
  }
}
