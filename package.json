{
  "name": "pace-calculator",
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "build": "bun run build:app && bun run storybook:build",
    "build:app": "vite build",
    "check": "biome check . && bun run check:deprecations",
    "check:deprecations": "bun scripts/check-deprecations.ts",
    "coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage && bun scripts/generate-coverage-report.ts && bun scripts/check-coverage.ts",
    "coverage:check": "bun scripts/check-coverage.ts",
    "db:migrate": "bun scripts/db-migrate.ts",
    "dev": "bun scripts/dev.ts",
    "dev:app": "bun run --hot src/index.ts",
    "dev:assets": "vite",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "protect:main": "bun scripts/configure-main-protection.ts",
    "screenshots:pr": "bun scripts/add-pr-screenshots.ts",
    "seed:admin": "bun scripts/seed-admin.ts",
    "seed:dev": "bun scripts/seed-local-dev.ts",
    "start": "bun src/index.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "bun test",
    "test:a11y": "bun scripts/test-a11y.ts",
    "test:e2e": "bun run build:app && bun -e 'await import(\"./scripts/test-e2e.ts\")'",
    "test:e2e:ui": "bun run build:app && bun -e 'await import(\"./scripts/test-e2e.ts\")' -- --ui",
    "test:storybook": "bun scripts/test-storybook.ts",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "^1.6.11",
    "hono": "^4.0.0",
    "htmx.org": "^2.0.10",
    "kysely": "^0.28.17",
    "open-props": "^1.7.0",
    "pg": "^8.20.0",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/html-vite": "^10.4.0",
    "@storybook/test-runner": "^0.24.4",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "pa11y": "^9.1.1",
    "storybook": "^10.4.0",
    "vite": "^8.0.13"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
